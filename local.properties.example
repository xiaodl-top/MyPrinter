# ---------------------------------------------------------------------------
# MyPrinter local configuration template
#
# Copy this file to "local.properties" (git-ignored) and fill in your own values.
# These DEFAULT_* values are injected into BuildConfig at build time; they are
# never stored in the repository. You can also provide them as Gradle properties
# (-PDEFAULT_API_URL=...) or as environment variables of the same name.
# ---------------------------------------------------------------------------

# Android SDK location. Usually written by Android Studio.
# Windows paths escape the colon and the backslashes, e.g.
# sdk.dir=D\:\\Android\\Sdk
#sdk.dir=

# Print service endpoint, e.g. http://192.168.1.10:8080/upload/single
DEFAULT_API_URL=

# Printer name as known by the print service, e.g. Office-Printer
DEFAULT_PRINTER=

# Access code required by the print service
DEFAULT_CODE=
